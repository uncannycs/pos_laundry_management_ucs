<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_laundry_inherit" model="ir.ui.view">
        <field name="name">pos.order.form.laundry.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_laundry_order" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not laundry_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Laundry Order</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_laundry_order" readonly="1"/>
                <field name="laundry_order_id" readonly="1" invisible="not laundry_order_id"/>
                <field name="laundry_status" widget="badge" invisible="not laundry_order_id"/>
                <field name="expected_delivery_date" readonly="1" invisible="not is_laundry_order"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_laundry_inherit" model="ir.ui.view">
        <field name="name">pos.order.tree.laundry.inherit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="laundry_status" widget="badge" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
