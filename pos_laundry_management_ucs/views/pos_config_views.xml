<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_laundry_inherit" model="ir.ui.view">
        <field name="name">pos.config.form.laundry.inherit</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <h2 class="mt-4">Laundry Management</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="enable_laundry"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="enable_laundry"/>
                            <div class="text-muted">
                                Enable laundry order workflows, delivery dates, and garment instructions in POS.
                            </div>
                            <div class="content-group mt-3" invisible="not enable_laundry">
                                <div class="row">
                                    <label for="default_delivery_fee" class="col-lg-5 o_light_label"/>
                                    <field name="default_delivery_fee" widget="monetary"/>
                                </div>
                                <div class="row mt-2">
                                    <label for="default_urgent_fee" class="col-lg-5 o_light_label"/>
                                    <field name="default_urgent_fee" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
