<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Laundry Order Kanban View -->
    <record id="view_laundry_order_kanban" model="ir.ui.view">
        <field name="name">laundry.order.kanban</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="expected_delivery_date"/>
                <field name="state"/>
                <field name="amount_total"/>
                <field name="is_urgent"/>
                <field name="is_home_delivery"/>
                <field name="payment_status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <span class="badge rounded-pill bg-danger" t-if="record.is_urgent.raw_value">URGENT</span>
                            </div>
                            <div class="text-muted mb-2">
                                <div><i class="fa fa-user me-1" title="Customer"/> <field name="partner_id"/></div>
                                <div><i class="fa fa-calendar me-1" title="Expected Delivery Date"/> <field name="expected_delivery_date" widget="date"/></div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 border-top pt-1">
                                <div>
                                    <span class="badge rounded-pill bg-success" t-if="record.payment_status.raw_value == 'paid'">Paid</span>
                                    <span class="badge rounded-pill bg-secondary" t-if="record.payment_status.raw_value == 'not_paid'">Unpaid</span>
                                </div>
                                <div>
                                    <strong><field name="amount_total" widget="monetary"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Laundry Order Tree View -->
    <record id="view_laundry_order_tree" model="ir.ui.view">
        <field name="name">laundry.order.tree</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <tree string="Laundry Orders" multi_edit="1" decoration-info="state == 'draft'" decoration-primary="state == 'received'" decoration-warning="state == 'processing'" decoration-success="state in ('ready', 'delivered')" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="expected_delivery_date" widget="date"/>
                <field name="is_urgent" widget="boolean_toggle"/>
                <field name="is_home_delivery" widget="boolean_toggle"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="amount_total" widget="monetary" sum="Total Amount"/>
                <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-danger="payment_status == 'not_paid'"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-primary="state == 'received'" decoration-warning="state == 'processing'" decoration-success="state in ('ready', 'delivered')" decoration-danger="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Laundry Order Form View -->
    <record id="view_laundry_order_form" model="ir.ui.view">
        <field name="name">laundry.order.form</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <form string="Laundry Order">
                <header>
                    <button name="action_receive" string="Mark Received" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_process" string="Start Processing" type="object" class="btn-primary" invisible="state != 'received'"/>
                    <button name="action_ready" string="Mark Ready" type="object" class="btn-primary" invisible="state != 'processing'"/>
                    <button name="action_deliver" string="Mark Delivered" type="object" class="btn-success" invisible="state != 'ready'"/>
                    <button name="%(action_laundry_order_cancel_wizard)d" string="Cancel Order" type="action" class="btn-secondary" invisible="state in ('delivered', 'cancel')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,processing,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pos_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not pos_order_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">POS Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state in ('delivered', 'cancel')"/>
                            <field name="order_date" readonly="state in ('delivered', 'cancel')"/>
                            <field name="expected_delivery_date" readonly="state in ('delivered', 'cancel')"/>
                            <field name="pos_order_id" readonly="1" invisible="not pos_order_id"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state in ('delivered', 'cancel')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state in ('delivered', 'cancel')"/>
                            <field name="payment_status" widget="badge" decoration-success="payment_status == 'paid'" decoration-danger="payment_status == 'not_paid'"/>
                            <label for="is_urgent" string="Express / Urgent"/>
                            <div class="o_row">
                                <field name="is_urgent" widget="boolean_toggle" readonly="state in ('delivered', 'cancel')"/>
                                <field name="urgent_charge" widget="monetary" invisible="not is_urgent" readonly="state in ('delivered', 'cancel')"/>
                            </div>
                            <label for="is_home_delivery" string="Home Delivery"/>
                            <div class="o_row">
                                <field name="is_home_delivery" widget="boolean_toggle" readonly="state in ('delivered', 'cancel')"/>
                                <field name="delivery_charge" widget="monetary" invisible="not is_home_delivery" readonly="state in ('delivered', 'cancel')"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Garments &amp; Services" name="order_lines">
                            <field name="order_line_ids" readonly="state in ('delivered', 'cancel')">
                                <tree editable="bottom">
                                    <field name="product_id" domain="[('is_laundry_product', '=', True)]"/>
                                    <field name="washing_type_id"/>
                                    <field name="note" placeholder="Garment instructions..."/>
                                    <field name="qty"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="hide"/>
                                    <field name="price_subtotal" widget="monetary" sum="Subtotal"/>
                                    <field name="price_total" widget="monetary" sum="Total"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2" name="laundry_total">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Special Instructions &amp; Notes" name="notes">
                            <field name="note" placeholder="Customer preferences, stain notes, or special handling instructions..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Laundry Order Search View -->
    <record id="view_laundry_order_search" model="ir.ui.view">
        <field name="name">laundry.order.search</field>
        <field name="model">laundry.order</field>
        <field name="arch" type="xml">
            <search string="Search Laundry Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Received" name="received" domain="[('state', '=', 'received')]"/>
                <filter string="Processing" name="processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Ready for Delivery" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter string="Urgent Orders" name="urgent" domain="[('is_urgent', '=', True)]"/>
                <filter string="Home Delivery" name="delivery" domain="[('is_home_delivery', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Order Date" name="group_order_date" context="{'group_by': 'order_date'}"/>
                    <filter string="Expected Delivery Date" name="group_delivery_date" context="{'group_by': 'expected_delivery_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Laundry Order Action -->
    <record id="action_laundry_order" model="ir.actions.act_window">
        <field name="name">Laundry Orders</field>
        <field name="res_model">laundry.order</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_laundry_order_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Laundry Order!
            </p>
            <p>
                Track garments, service types, processing progress, and delivery schedules for your customers.
            </p>
        </field>
    </record>
</odoo>
