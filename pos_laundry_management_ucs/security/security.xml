<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Category -->
        <record id="module_category_laundry_management" model="ir.module.category">
            <field name="name">Laundry Management</field>
            <field name="description">User access levels for Laundry Management System.</field>
            <field name="sequence">30</field>
        </record>

        <!-- Privilege -->
        <record id="res_groups_privilege_laundry_management" model="res.groups.privilege">
            <field name="name">Laundry Management</field>
            <field name="sequence">30</field>
            <field name="category_id" ref="module_category_laundry_management"/>
        </record>

        <!-- Laundry User Group -->
        <record id="group_laundry_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_laundry_management"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <!-- Laundry Manager Group -->
        <record id="group_laundry_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_laundry_management"/>
            <field name="implied_ids" eval="[(4, ref('group_laundry_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Multi-Company Record Rule: Laundry Order -->
        <record id="laundry_order_comp_rule" model="ir.rule">
            <field name="name">Laundry Order Multi-Company</field>
            <field name="model_id" ref="model_laundry_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Multi-Company Record Rule: Laundry Washing Type -->
        <record id="laundry_washing_type_comp_rule" model="ir.rule">
            <field name="name">Laundry Washing Type Multi-Company</field>
            <field name="model_id" ref="model_laundry_washing_type"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
