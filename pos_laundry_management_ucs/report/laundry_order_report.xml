<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Report Action for Laundry Order -->
    <record id="action_report_laundry_order" model="ir.actions.report">
        <field name="name">Laundry Work Ticket / Receipt</field>
        <field name="model">laundry.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_laundry_management_ucs.report_laundry_order</field>
        <field name="report_file">pos_laundry_management_ucs.report_laundry_order</field>
        <field name="print_report_name">'Laundry_Order_%s' % (object.name.replace('/', '_'))</field>
        <field name="binding_model_id" ref="model_laundry_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
