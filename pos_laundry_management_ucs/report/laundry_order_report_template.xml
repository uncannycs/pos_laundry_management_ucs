<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_laundry_order_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="page mb-4">
                <div class="row mb-3">
                    <div class="col-8">
                        <h2>
                            <span>Laundry Order Ticket # </span>
                            <span t-field="doc.name"/>
                        </h2>
                    </div>
                    <div class="col-4 text-end">
                        <span t-if="doc.is_urgent" class="badge bg-danger p-2 fs-6">URGENT / EXPRESS</span>
                        <span t-if="doc.is_home_delivery" class="badge bg-info p-2 fs-6 ms-1">HOME DELIVERY</span>
                    </div>
                </div>

                <div class="row mt-3 mb-4">
                    <div class="col-6">
                        <strong>Customer Details:</strong>
                        <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True}'/>
                    </div>
                    <div class="col-6 text-end">
                        <div><strong>Order Date:</strong> <span t-field="doc.order_date"/></div>
                        <div><strong>Expected Delivery:</strong> <span t-field="doc.expected_delivery_date"/></div>
                        <div><strong>Status:</strong> <span class="text-uppercase fw-bold" t-field="doc.state"/></div>
                        <div><strong>Payment Status:</strong> <span class="text-uppercase" t-field="doc.payment_status"/></div>
                    </div>
                </div>

                <table class="table table-sm table-striped mt-3">
                    <thead>
                        <tr class="table-dark">
                            <th>Garment / Item</th>
                            <th>Service / Washing Type</th>
                            <th>Garment Instructions</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.order_line_ids" t-as="line">
                            <td><span t-field="line.product_id.name"/></td>
                            <td><span t-field="line.washing_type_id.name"/></td>
                            <td><span t-field="line.note"/></td>
                            <td class="text-end"><span t-field="line.qty"/></td>
                            <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            <td class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end mt-3">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>Untaxed Amount:</strong></td>
                                <td class="text-end"><span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Taxes:</strong></td>
                                <td class="text-end"><span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr t-if="doc.is_urgent">
                                <td><strong>Urgent Fee:</strong></td>
                                <td class="text-end"><span t-field="doc.urgent_charge" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr t-if="doc.is_home_delivery">
                                <td><strong>Home Delivery Fee:</strong></td>
                                <td class="text-end"><span t-field="doc.delivery_charge" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></td>
                            </tr>
                            <tr class="border-top border-dark">
                                <td><strong>Total Amount:</strong></td>
                                <td class="text-end"><strong><span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div t-if="doc.note" class="mt-4 p-3 bg-light rounded border">
                    <strong>Special Instructions / Notes:</strong>
                    <p class="mb-0" t-field="doc.note"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_laundry_order">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="pos_laundry_management_ucs.report_laundry_order_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
